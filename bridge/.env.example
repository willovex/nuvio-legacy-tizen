# Nuvio Bridge configuration — copy to `.env` (or pass as Docker env vars)

# Port the bridge listens on (LAN, plain HTTP)
PORT=7070

# Nuvio account backend (Supabase). Default is the public Nuvio API.
NUVIO_API=https://api.nuvio.tv
# Nuvio Supabase anon (public) key — read it from the official Nuvio TV build's
# nuvio.env.js (SUPABASE_ANON_KEY). Required for account login / sync.
NUVIO_ANON_KEY=YOUR_NUVIO_SUPABASE_ANON_KEY

# TMDB API key (v3) for catalogs, metadata, imdb<->tmdb mapping.
TMDB_KEY=YOUR_TMDB_API_KEY

# UI language for TMDB catalogs/metadata
TMDB_LANG=en-US

# Optional: comma-separated Nuvio provider repo manifest URLs (fallback scrapers)
# NUVIO_REPOS=https://raw.githubusercontent.com/yoruix/nuvio-providers/main/manifest.json
